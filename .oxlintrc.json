{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["**/*.test.js", "dist/**", "node_modules/**", "coverage/**", "package-lock.json", "*.min.js"],

  "plugins": ["unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "import/no-cycle": ["error", { "maxDepth": 3 }]
  },
  "env": {
    "builtin": true
  }
}
